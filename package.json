{
  "name": "eazy-school-360-infra-tests",
  "private": true,
  "description": "Firestore security rules tests and dev tooling for EazySchool 360 (tenant isolation / RBAC). See docs/architecture/data-ownership.md.",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore \"jest --config jest.config.js\"",
    "seed:dev": "firebase emulators:exec --only auth,firestore \"node scripts/seed-dev-data.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/jest": "^29.5.14",
    "firebase-admin": "^12.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
