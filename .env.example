# EazySchool 360 — environment template.
#
# No real secrets belong in this file, or in ANY file committed to source
# control (see CLAUDE.md "No secrets in source, ever"). Firebase client
# config (apiKey, projectId, etc.) is intentionally public and lives in
# lib/firebase_options_<environment>.dart instead — see
# docs/architecture/overview.md.
#
# This file exists so future server-side secrets (a third-party API key, a
# webhook signing secret, etc.) have an established place to be documented
# without ever being committed with real values. Copy it to `.env` locally
# and fill in real values there; `.env` is gitignored.

# Which environment this shell/CI job targets. One of: development, uat, production.
ENVIRONMENT=development
